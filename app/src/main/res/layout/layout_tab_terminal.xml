<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Quick Commands Scroll -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_chip_atrv"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="ATRV (Aki)"
                android:textColor="@color/primary"
                android:textSize="11sp"
                app:strokeColor="@color/surface_card_stroke"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_chip_0100"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="0100 (ECU Ping)"
                android:textColor="@color/primary"
                android:textSize="11sp"
                app:strokeColor="@color/surface_card_stroke"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_chip_atdp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="ATDP (Protokol)"
                android:textColor="@color/primary"
                android:textSize="11sp"
                app:strokeColor="@color/surface_card_stroke"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_chip_010c"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="010C (RPM)"
                android:textColor="@color/primary"
                android:textSize="11sp"
                app:strokeColor="@color/surface_card_stroke"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_chip_03"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="03 (Baca DTC)"
                android:textColor="@color/primary"
                android:textSize="11sp"
                app:strokeColor="@color/surface_card_stroke"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_chip_atz"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="ATZ (Reset ELM)"
                android:textColor="@color/neon_amber"
                android:textSize="11sp"
                app:strokeColor="@color/surface_card_stroke"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Terminal Output Area -->
    <ScrollView
        android:id="@+id/scroll_terminal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_terminal"
        android:padding="12dp"
        android:layout_marginBottom="10dp"
        android:fillViewport="true">

        <TextView
            android:id="@+id/tv_terminal_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Konsol OBD Siap.\nKetik perintah AT atau PID untuk mengirim langsung ke ECU..."
            android:textColor="@color/console_text"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />
    </ScrollView>

    <!-- Bottom Input Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btn_clear_terminal"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_badge"
            android:src="@drawable/ic_delete"
            app:tint="@color/text_muted"
            android:contentDescription="Clear"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/et_terminal_input"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_badge"
            android:fontFamily="monospace"
            android:hint="Ketik ATZ, 0100, ATRV..."
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_dim"
            android:textSize="14sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:inputType="textCapCharacters"
            android:imeOptions="actionSend"
            android:maxLines="1" />

        <ImageButton
            android:id="@+id/btn_send_cmd"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_badge"
            android:src="@drawable/ic_send"
            app:tint="@color/primary"
            android:contentDescription="Send"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
